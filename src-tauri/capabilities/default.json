{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["haupt"],
  "remote": {
    "urls": ["http://127.0.0.1:4747/*"]
  },
  "permissions": [
    "core:default",
    "core:webview:allow-print",
    "dialog:allow-save",
    "allow-programm-beenden",
    "allow-programm-neu-starten",
    "allow-drucken",
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$HOME/**" }, { "path": "$TEMP/el-easy-cad-anlagen/**" }]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$TEMP/el-easy-cad-anlagen" }, { "path": "$TEMP/el-easy-cad-anlagen/**" }]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$TEMP/el-easy-cad-anlagen/**" }]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/tommx0/el-easy-cad" },
        { "url": "https://github.com/tommx0/el-easy-cad/*" }
      ]
    }
  ]
}
